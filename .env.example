# LLM (DeepSeek-compatible OpenAI API)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# mock | live — Phase A defaults to mock when key is empty
LLM_MODE=mock

# Generation backends: mock | live
GENERATION_BACKEND=mock

# Service URLs (used when GENERATION_BACKEND=live)
FLUX_SERVICE_URL=http://127.0.0.1:8001
H3_SERVICE_URL=http://127.0.0.1:13011

# Paths
RUNS_DIR=runs
MODELS_DIR=/data/models

# HTTP
API_HOST=127.0.0.1
API_PORT=8000
# Gradio uses this address to call FastAPI.  For Docker Compose use http://api:8000.
API_BASE_URL=http://127.0.0.1:8000
API_PIPELINE_TIMEOUT_SEC=180
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860
